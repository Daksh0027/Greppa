# Greppa Frontend Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.local.example .env.local
# 2. Update the API URL if your backend runs on a different port/host
# 3. Never commit .env.local to git
#

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: Your Gemini API key (can also be passed via API headers)
# NEXT_PUBLIC_GEMINI_API_KEY=your-key-here

# Optional: GitHub token for higher rate limits
# NEXT_PUBLIC_GITHUB_TOKEN=your-token-here
