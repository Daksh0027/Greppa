# Greppa Configuration

# LLM Provider - Google Gemini
# Provide your Gemini API key here, or pass it dynamically from the UI or via X-Gemini-Api-Key header
GEMINI_API_KEY=
CHEAP_MODEL_NAME=gemini-2.0-flash
STRONG_MODEL_NAME=gemini-2.0-pro
EMBEDDING_MODEL_NAME=text-embedding-004

# Database
# For full Docker PostgreSQL + pgvector:
DATABASE_URL=postgresql+asyncpg://greppa:greppa@localhost:5432/greppa
DATABASE_SYNC_URL=postgresql+psycopg2://greppa:greppa@localhost:5432/greppa
# Set USE_SQLITE_FALLBACK=True for zero-install local testing without running Docker
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=greppa.db

# Redis & Storage
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
