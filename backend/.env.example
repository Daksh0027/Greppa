# Greppa Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Add your actual API keys to .env (NOT this file)
# 3. Never commit .env to git
#

# LLM Provider - Google Gemini
# Get a free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
CHEAP_MODEL_NAME=gemini-2.0-flash
STRONG_MODEL_NAME=gemini-2.0-pro
EMBEDDING_MODEL_NAME=text-embedding-004
EMBEDDING_DIM=768

# Database Configuration
# For local development with SQLite (easiest, no setup needed):
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=greppa.db

# For production with PostgreSQL + pgvector (recommended):
# USE_SQLITE_FALLBACK=False
# DATABASE_URL=postgresql+asyncpg://greppa:greppa@localhost:5432/greppa
# DATABASE_SYNC_URL=postgresql+psycopg2://greppa:greppa@localhost:5432/greppa

# Redis (optional, for production)
# REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=./storage

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Greppa
